# Copie para .env.local e preencha. Nunca commite .env.local.

# Token de Private Integration do GHL (prefixo pit-).
# Escopos necessários: contacts.write, opportunities.write, opportunities.readonly
GHL_API_TOKEN=
# ID da location (sub-conta) no GHL.
GHL_LOCATION_ID=

# Opcionais — sobrescrevem o funil de destino da oportunidade.
# Padrão: "1. Funil de Vendas" / estágio "Novo Contato".
# GHL_PIPELINE_ID=
# GHL_PIPELINE_STAGE_ID=
